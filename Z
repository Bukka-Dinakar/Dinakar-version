private List<OutageReportStatus> combineStatusReports(
        List<OutageReportStatus> tigoFalseReports,
        List<OutageReportStatus> tigoTrueReports) {

    List<OutageReportStatus> combinedReports = new ArrayList<>();

    List<String> statusList = Arrays.asList(
            "SUCCESS",
            "FAILED",
            "QUESTIONABLE",
            "INVALID",
            "QUEUED",
            "PENDING"
    );

    for (String status : statusList) {

        long count = 0;

        count += tigoFalseReports.stream()
                .filter(x -> status.equalsIgnoreCase(x.getStatus()))
                .mapToLong(OutageReportStatus::getCount)
                .sum();

        count += tigoTrueReports.stream()
                .filter(x -> status.equalsIgnoreCase(x.getStatus()))
                .mapToLong(OutageReportStatus::getCount)
                .sum();

        OutageReportStatus report = new OutageReportStatus();

        report.setStatus(status);
        report.setCount(count);

        combinedReports.add(report);
    }

    return combinedReports;
}

