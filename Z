private void appendStatusColumns(
        StringBuilder html,
        OutageReportStatus outageReportStatus) {

    if (outageReportStatus == null) {

        html.append("<td style='text-align:right;'>0</td>");

        for (int i = 0; i < 4; i++) {
            html.append("<td style='text-align:right;'>-</td>");
        }

        return;
    }

    // Count
    html.append("<td style='text-align:right;'>")
            .append(outageReportStatus.getCount())
            .append("</td>");

    // Minimum duration
    if (outageReportStatus.getMinDuration() != null) {

        html.append("<td style='text-align:right;'>")
                .append(outageReportStatus.getMinDuration())
                .append("</td>");

    } else {

        html.append("<td style='text-align:right;'>-</td>");
    }

    // Maximum duration
    if (outageReportStatus.getMaxDuration() != null) {

        html.append("<td style='text-align:right;'>")
                .append(outageReportStatus.getMaxDuration())
                .append("</td>");

    } else {

        html.append("<td style='text-align:right;'>-</td>");
    }

    // Mean duration
    if (outageReportStatus.getAverageDuration() != null) {

        html.append("<td style='text-align:right;'>")
                .append(String.format(
                        "%.2f",
                        outageReportStatus.getAverageDuration()))
                .append("</td>");

    } else {

        html.append("<td style='text-align:right;'>-</td>");
    }

    // Median duration
    if (outageReportStatus.getMedianDuration() != null) {

        html.append("<td style='text-align:right;'>")
                .append(String.format(
                        "%.2f",
                        outageReportStatus.getMedianDuration()))
                .append("</td>");

    } else {

        html.append("<td style='text-align:right;'>-</td>");
    }
}

